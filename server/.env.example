# Server Configuration
PORT=5000

# JWT Secret (Generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Telegram Bot Configuration (Optional)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_NOTIFY_TIME=09:00

# E-posta Doğrulama (Gmail SMTP) - Kayıt ve şifre sıfırlama için
# EMAIL_PASS: Gmail uygulama şifresi (app password), normal şifre değil
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
